' iOS PlantUML Theme — Dark (mirrored semantics)
!$ACCENT  = "#3B82F6"
!$SUCCESS = "#16A34A"
!$WARNING = "#D97706"
!$DANGER  = "#DC2626"

skinparam backgroundColor #111827
skinparam shadowing false
skinparam roundcorner 12
skinparam dpi 160
skinparam defaultFontName Inter
skinparam titleFontColor #F9FAFB
skinparam actorStyle awesome

skinparam ArrowColor $ACCENT
skinparam ArrowThickness 1.5
skinparam HyperlinkColor $ACCENT

skinparam note {
  BackgroundColor #2A2415
  BorderColor $WARNING
  FontColor #FFE9A8
  FontName Inter
  RoundCorner 8
}

skinparam activity {
  FontName Inter
  FontColor #F9FAFB
  FontSize 15
  StartColor $SUCCESS
  EndColor $DANGER
  BackgroundColor #1F2937
  BorderColor #374151
  ArrowColor $ACCENT
  DiamondBackgroundColor #1E3A8A
  DiamondBorderColor #3B82F6
  DiamondFontColor #F9FAFB
}

skinparam sequence {
  ParticipantBackgroundColor #1F2937
  ParticipantBorderColor #374151
  ParticipantFontColor #F9FAFB
  LifeLineBackgroundColor #111827
  LifeLineBorderColor #4B5563
  ArrowColor $ACCENT
  ArrowFontColor #F9FAFB
  GroupBackgroundColor #1F2937
  GroupBorderColor #374151
  GroupHeaderFontColor #F9FAFB
}

skinparam class {
  BackgroundColor #1F2937
  BorderColor #374151
  FontColor #F9FAFB
  HeaderBackgroundColor #1E3A8A
  HeaderFontColor #F9FAFB
  AttributeFontColor #9CA3AF
  MethodFontColor #9CA3AF
  ArrowColor $ACCENT
}

skinparam component {
  BackgroundColor #1F2937
  BorderColor #374151
  FontColor #F9FAFB
  ArrowColor $ACCENT
}

skinparam usecase {
  BackgroundColor #1F2937
  BorderColor #374151
  FontColor #F9FAFB
  ArrowColor $ACCENT
}

skinparam state {
  BackgroundColor #1F2937
  BorderColor #374151
  FontColor #F9FAFB
  StartColor $SUCCESS
  EndColor $DANGER
  ArrowColor $ACCENT
}

skinparam package {
  BackgroundColor #111827
  BorderColor #4B5563
  FontColor #F9FAFB
}

skinparam actor {
    BackgroundColor  #1F2937
    BorderColor      $ACCENT
    FontColor        #F9FAFB
    FontSize         13
}

<style>
mindmapDiagram {
  node {
    BackGroundColor #1F2937
    LineColor #374151
    LineThickness 1.2
    FontColor #F9FAFB
    FontName Inter
    RoundCorner 12
    Padding 8
  }
  rootNode {
    BackGroundColor #1E3A8A
    LineColor #3B82F6
    FontColor #F9FAFB
    FontStyle bold
  }
  leafNode {
    BackGroundColor #1F2937
    LineColor #374151
    FontColor #9CA3AF
  }
  arrow {
    LineColor #3B82F6
    FontColor #F9FAFB
  }
}

wbsDiagram {
  node {
    BackGroundColor #1F2937
    LineColor #374151
    LineThickness 1.2
    FontColor #F9FAFB
    FontName Inter
    RoundCorner 12
    Padding 8
  }
  rootNode {
    BackGroundColor #1E3A8A
    LineColor #3B82F6
    FontColor #F9FAFB
    FontStyle bold
  }
  arrow {
    LineColor #3B82F6
    FontColor #F9FAFB
  }
}
</style>