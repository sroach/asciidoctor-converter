' iOS PlantUML Theme — Light
!$ACCENT  = "#3B82F6"
!$SUCCESS = "#16A34A"
!$WARNING = "#D97706"
!$DANGER  = "#DC2626"

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam dpi 160
skinparam defaultFontName Inter
skinparam titleFontColor #111827
skinparam actorStyle awesome

skinparam ArrowColor $ACCENT
skinparam ArrowThickness 1.5
skinparam HyperlinkColor $ACCENT

skinparam note {
  BackgroundColor #FFFBEB
  BorderColor $WARNING
  FontColor #92400E
  FontName Inter
  RoundCorner 8
}

skinparam activity {
  FontName Inter
  FontColor #111827
  FontSize 15
  StartColor $SUCCESS
  EndColor $DANGER
  BackgroundColor #FFFFFF
  BorderColor #E5E7EB
  ArrowColor $ACCENT
  DiamondBackgroundColor #F0F9FF
  DiamondBorderColor #BAE6FD
  DiamondFontColor #111827
}

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #E5E7EB
  ParticipantFontColor #111827
  LifeLineBackgroundColor #F9FAFB
  LifeLineBorderColor #D1D5DB
  ArrowColor $ACCENT
  ArrowFontColor #111827
  GroupBackgroundColor #FFFFFF
  GroupBorderColor #E5E7EB
  GroupHeaderFontColor #111827
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #E5E7EB
  FontColor #111827
  HeaderBackgroundColor #F0F9FF
  HeaderFontColor #111827
  AttributeFontColor #374151
  MethodFontColor #374151
  ArrowColor $ACCENT
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #E5E7EB
  FontColor #111827
  ArrowColor $ACCENT
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #E5E7EB
  FontColor #111827
  ArrowColor $ACCENT
}

skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #E5E7EB
  FontColor #111827
  StartColor $SUCCESS
  EndColor $DANGER
  ArrowColor $ACCENT
}

skinparam package {
  BackgroundColor #F9FAFB
  BorderColor #D1D5DB
  FontColor #111827
}

skinparam actor {
    BackgroundColor  #FFFFFF
    BorderColor      $ACCENT
    FontColor        #111827
    FontSize         13
}

<style>
mindmapDiagram {
  node {
    BackGroundColor #FFFFFF
    LineColor #E5E7EB
    LineThickness 1.2
    FontColor #111827
    FontName Inter
    RoundCorner 12
    Padding 8
  }
  rootNode {
    BackGroundColor #F0F9FF
    LineColor #3B82F6
    FontColor #111827
    FontStyle bold
  }
  leafNode {
    BackGroundColor #FFFFFF
    LineColor #E5E7EB
    FontColor #374151
  }
  arrow {
    LineColor #3B82F6
    FontColor #111827
  }
}

wbsDiagram {
  node {
    BackGroundColor #FFFFFF
    LineColor #E5E7EB
    LineThickness 1.2
    FontColor #111827
    FontName Inter
    RoundCorner 12
    Padding 8
  }
  rootNode {
    BackGroundColor #F0F9FF
    LineColor #3B82F6
    FontColor #111827
    FontStyle bold
  }
  arrow {
    LineColor #3B82F6
    FontColor #111827
  }
}
</style>